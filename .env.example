# API base URL (Playwright config, global setup, and authenticated requests)
BASE_URL=https://api.bestinfra.app

# Optional: preferred role name for AUTH invite tests (defaults to Manager from roles catalog)
# INVITE_TEST_ROLE=Manager

# Invite flow — ONE token from the invitation email is reused by every invite spec:
#   invite-e2e, invite-validate, invite-preview, invite-accept-validate
#
# Option A — IMAP auto-capture (Gmail or mail.com / @email.com):
#   Gmail: Google Account → Security → 2-Step Verification → App passwords → Mail
#   @email.com (mail.com): Settings → POP3/IMAP → enable IMAP → use mailbox password
#   Set GMAIL_IMAP_USER + GMAIL_IMAP_APP_PASSWORD below
#   invite-e2e Step 1 polls inbox and saves token to playwright/.auth/invite-token.json
#   Invites use plus-addressing (user+e2e-invite-123@domain.com) when supported.
#
# Gmail (default host imap.gmail.com):
#   GMAIL_IMAP_USER=you@gmail.com
#   GMAIL_IMAP_APP_PASSWORD=16charGoogleAppPassword
#
# mail.com / @email.com example:
#   GMAIL_IMAP_USER=vamsibst@email.com
#   GMAIL_IMAP_APP_PASSWORD=your-mailbox-password
#   GMAIL_IMAP_HOST=imap.mail.com
#   INVITE_INBOX_EMAIL=vamsibst@email.com
#   GMAIL_INVITE_MAILBOXES=INBOX
#
# Option B — Manual: copy token from email → INVITE_ACCEPT_TOKEN (+ INVITE_E2E_*)
#
# GMAIL_IMAP_USER=you@gmail.com
# GMAIL_IMAP_APP_PASSWORD=abcdefghijklmnop
# ^ 16-char App Password from Google (NOT your Gmail login password)
#
# Optional: different address for invite delivery (defaults to GMAIL_IMAP_USER).
# Must still be readable via GMAIL_IMAP_* (same inbox or alias on that account).
# INVITE_INBOX_EMAIL=automation-team@gmail.com
# GMAIL_INVITE_CAPTURE_TIMEOUT_MS=180000
# GMAIL_INVITE_CAPTURE_POLL_MS=5000
# GMAIL_INVITE_MAILBOXES=INBOX,[Gmail]/Spam
# GMAIL_INVITE_SCAN_LIMIT=40
# GMAIL_INVITE_SUBJECT_CONTAINS=invit
#
# Each invite-e2e run sends a NEW invite + captures a NEW token (repeatable).
# Set INVITE_E2E_REUSE_CONTEXT=true only to re-run Steps 3–5 with existing token (pending invite).
# INVITE_E2E_REUSE_CONTEXT=false
# Preview URL example: https://api.bestinfra.app/indore/auth/invite/preview?token=...
# INVITE_ACCEPT_TOKEN=
# INVITE_ACCEPT_URL=https://api.bestinfra.app/indore/auth/invite/preview?token=...
# INVITE_E2E_EMAIL=invitee@example.com
# INVITE_E2E_INVITATION_ID=009cd3f0-c6b7-4f7d-b764-979abaa51c8a
# INVITE_E2E_ROLE=Admin
# INVITE_E2E_EXPIRES_AT=2026-06-11T08:22:26.068Z
# INVITE_E2E_PASSWORD=Automation@Invite123
# INVITE_E2E_FIRST_NAME=TEST
# INVITE_E2E_LAST_NAME=QA
# INVITE_E2E_PHONE=8919018787
# INVITE_E2E_DESIGNATION=QA-2

# Credentials for POST /indore/auth/login (src/global.setup.ts)
# Use EMAIL or USERNAME (at least one is required).
EMAIL=
USERNAME=
PASSWORD=

# Optional: required when login returns requiresDeviceSelection
DEVICE_ID=

# PostgreSQL — optional read-only API-vs-DB validation (never commit real credentials)
# DB_NAME must be lowercase (PostgreSQL): mdms_indore | mdms_indore_qa | mdms_indore_archive
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=mdms_indore
DB_SSL=false
DB_CONSUMER_MASTER_VIEW=public."V_Consumer_Master_Data"

# HES ↔ MDM integration (CyanConnode Omnimesh SMA — src/modules/HES-MDM)
# Base URL per doc §1: https://servername/sma/ws
HES_BASE_URL=https://servername/sma/ws
HES_USERNAME=
HES_PASSWORD=
HES_TEST_METER_ID=
HES_CALLBACK_URL=
# Default block load profile; use 1.0.94.91.0.255 for instantaneous (§4.1 V1.5)
HES_ODR_OBIS_CODE=1.0.99.1.0.255

# MDM Commands API (src/commands — backend /commands/* layer)
# Set COMMANDS_ENABLED=true when /commands/* endpoints are available
COMMANDS_ENABLED=false
COMMANDS_BASE_URL=
COMMANDS_AUTH_PATH=/indore/auth/login
ADMIN_EMAIL=
ADMIN_PASSWORD=
VALID_METER_SERIAL=
BULK_METER_SERIALS=
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
VIEWER_EMAIL=
VIEWER_PASSWORD=
CONSUMER_EMAIL=
CONSUMER_PASSWORD=
JOB_POLL_TIMEOUT_MS=60000
JOB_POLL_INTERVAL_MS=2000
