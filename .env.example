# API base URL (Playwright config, global setup, and authenticated requests)
BASE_URL=https://api.bestinfra.app

# Credentials for POST /indore/auth/login (src/global.setup.ts)
# Use EMAIL or USERNAME (at least one is required).
EMAIL=
USERNAME=
PASSWORD=

# Optional: required when login returns requiresDeviceSelection
DEVICE_ID=

# HES ↔ MDM integration (CyanConnode Omnimesh SMA — src/modules/HES-MDM)
# Base URL per doc §1: https://servername/sma/ws
HES_BASE_URL=https://servername/sma/ws
HES_USERNAME=
HES_PASSWORD=
HES_TEST_METER_ID=
HES_CALLBACK_URL=
# Default block load profile; use 1.0.94.91.0.255 for instantaneous (§4.1 V1.5)
HES_ODR_OBIS_CODE=1.0.99.1.0.255

# MDM Commands API (src/commands — backend /commands/* layer)
# Set COMMANDS_ENABLED=true when /commands/* endpoints are available
COMMANDS_ENABLED=false
COMMANDS_BASE_URL=
COMMANDS_AUTH_PATH=/indore/auth/login
ADMIN_EMAIL=
ADMIN_PASSWORD=
VALID_METER_SERIAL=
BULK_METER_SERIALS=
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
VIEWER_EMAIL=
VIEWER_PASSWORD=
CONSUMER_EMAIL=
CONSUMER_PASSWORD=
JOB_POLL_TIMEOUT_MS=60000
JOB_POLL_INTERVAL_MS=2000
