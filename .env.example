# API base URL (Playwright config, global setup, and authenticated requests)
BASE_URL=https://api.bestinfra.app

# Optional: preferred role name for AUTH invite tests (defaults to Manager from roles catalog)
# INVITE_TEST_ROLE=Manager

# Invite flow — ONE token from the invitation email is reused by every invite spec:
#   invite-e2e, invite-validate, invite-preview, invite-accept-validate
#
# Option A — IMAP auto-capture (Gmail or mail.com / @email.com):
#   Gmail: Google Account → Security → 2-Step Verification → App passwords → Mail
#   @email.com (mail.com): Settings → POP3/IMAP → enable IMAP → use mailbox password
#   Set GMAIL_IMAP_USER + GMAIL_IMAP_APP_PASSWORD below
#   invite-e2e Step 1 polls inbox and saves token to playwright/.auth/invite-token.json
#   Invites use plus-addressing (user+e2e-invite-123@domain.com) when supported.
#
# Gmail (default host imap.gmail.com):
#   GMAIL_IMAP_USER=you@gmail.com
#   GMAIL_IMAP_APP_PASSWORD=16charGoogleAppPassword
#
# mail.com / @email.com example:
#   GMAIL_IMAP_USER=vamsibst@email.com
#   GMAIL_IMAP_APP_PASSWORD=your-mailbox-password
#   GMAIL_IMAP_HOST=imap.mail.com
#   INVITE_INBOX_EMAIL=vamsibst@email.com
#   GMAIL_INVITE_MAILBOXES=INBOX
#
# Option B — Manual: copy token from email → INVITE_ACCEPT_TOKEN (+ INVITE_E2E_*)
#
# GMAIL_IMAP_USER=you@gmail.com
# GMAIL_IMAP_APP_PASSWORD=abcdefghijklmnop
# ^ 16-char App Password from Google (NOT your Gmail login password)
#
# Optional: different address for invite delivery (defaults to GMAIL_IMAP_USER).
# Must still be readable via GMAIL_IMAP_* (same inbox or alias on that account).
# INVITE_INBOX_EMAIL=automation-team@gmail.com
# GMAIL_INVITE_CAPTURE_TIMEOUT_MS=180000
# GMAIL_INVITE_CAPTURE_POLL_MS=5000
# GMAIL_INVITE_MAILBOXES=INBOX,[Gmail]/Spam
# GMAIL_INVITE_SCAN_LIMIT=40
# GMAIL_INVITE_SUBJECT_CONTAINS=invit
#
# Each invite-e2e run sends a NEW invite + captures a NEW token (repeatable).
# Set INVITE_E2E_REUSE_CONTEXT=true only to re-run Steps 3–5 with existing token (pending invite).
# INVITE_E2E_REUSE_CONTEXT=false
# Preview URL example: https://api.bestinfra.app/indore/auth/invite/preview?token=...
# INVITE_ACCEPT_TOKEN=
# INVITE_ACCEPT_URL=https://api.bestinfra.app/indore/auth/invite/preview?token=...
# INVITE_E2E_EMAIL=invitee@example.com
# INVITE_E2E_INVITATION_ID=009cd3f0-c6b7-4f7d-b764-979abaa51c8a
# INVITE_E2E_ROLE=Admin
# INVITE_E2E_EXPIRES_AT=2026-06-11T08:22:26.068Z
# INVITE_E2E_PASSWORD=Automation@Invite123
# INVITE_E2E_FIRST_NAME=TEST
# INVITE_E2E_LAST_NAME=QA
# INVITE_E2E_PHONE=8919018787
# INVITE_E2E_DESIGNATION=QA-2

# Credentials for POST /indore/auth/login (src/global.setup.ts)
# Use EMAIL or USERNAME (at least one is required).
EMAIL=
USERNAME=
PASSWORD=

# User Admin — user with registered devices for GET/DELETE /users/:id/devices tests
# DEVICE_TEST_USER_ID=6012ce6a-cbb2-4b58-b38c-a969ff4507ed

# Optional: required when login returns requiresDeviceSelection
DEVICE_ID=

# PostgreSQL — optional read-only API-vs-DB validation (never commit real credentials)
# DB_NAME must be lowercase (PostgreSQL): mdms_indore | mdms_indore_qa | mdms_indore_archive
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=mdms_indore
DB_SSL=false
DB_ARCHIVE_NAME=mdms_indore_archive
DB_CONSUMER_MASTER_VIEW=public."V_Consumer_Master_Data"

# HES ↔ MDM integration (CyanConnode Omnimesh SMA — src/modules/HES-MDM)
# Base URL per doc §1: https://servername/sma/ws
HES_BASE_URL=https://servername/sma/ws
HES_USERNAME=
HES_PASSWORD=
HES_TEST_METER_ID=
HES_CALLBACK_URL=
# Default block load profile; use 1.0.94.91.0.255 for instantaneous (§4.1 V1.5)
HES_ODR_OBIS_CODE=1.0.99.1.0.255

# MDM Commands API (src/commands — backend /commands/* layer)
# Set COMMANDS_ENABLED=true when /commands/* endpoints are available
COMMANDS_ENABLED=false
COMMANDS_BASE_URL=
COMMANDS_AUTH_PATH=/indore/auth/login
ADMIN_EMAIL=
ADMIN_PASSWORD=
VALID_METER_SERIAL=
BULK_METER_SERIALS=
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
VIEWER_EMAIL=
VIEWER_PASSWORD=
CONSUMER_EMAIL=
CONSUMER_PASSWORD=
# Consumer IVRS for CONSUMERS module smoke tests (profile, power-quality, real-time-power)
CONSUMER_NUMBER=N3477021215
# Audit log CSV export path (404 on live until backend deploys export route)
# AUDIT_LOG_EXPORT_PATH=/indore/users/audit-logs/export
# HES command E2E — poll until job FINISHED (async via HES callback on init)
# POST returns IN_PROGRESS immediately; GET query-meter-job stays RUNNING until callback updates it.
# JOB_POLL_TIMEOUT_MS=360000
# JOB_POLL_INTERVAL_MS=3000
# HES_JOB_MIN_GAP_MS=10000
# Run HES tests with one worker: npm run test:hes  (or PLAYWRIGHT_WORKERS=1)

# Energy Audit — loss-analysis anchor nodes (networkType=dtr | feeder)
ENERGY_AUDIT_DTR_NETWORK_LOOKUP_ID=5
ENERGY_AUDIT_FEEDER_NETWORK_LOOKUP_ID=4
ENERGY_AUDIT_NETWORK_TRENDS_LOOKUP_ID=6081
ENERGY_AUDIT_LOSS_ANALYSIS_STATS_LOOKUP_ID=6081
ENERGY_AUDIT_LOSS_ANALYSIS_STATS_FROM_DATE=2025-12-01
ENERGY_AUDIT_LOSS_ANALYSIS_STATS_TO_DATE=2025-12-20
ENERGY_AUDIT_LOSS_ANALYSIS_TRENDS_LOOKUP_ID=6081

# Master Data — meter communication status optional scope filters
# MDM_METER_COMM_ORG_LOOKUP_ID=
# MDM_METER_COMM_NETWORK_LOOKUP_ID=

# Master Data — validate-dtr-meter test serials (validate-dtr-meter.spec.ts)
# Assignable meters for create-dtr / bulk-upload-dtr are auto-created in spec beforeAll.
VALIDATE_DTR_METER_VALID_SERIAL=
VALIDATE_DTR_METER_ON_DTR_SERIAL=
VALIDATE_DTR_METER_INACTIVE_SERIAL=
VALIDATE_DTR_METER_ASSIGNED_SERIAL=

# Consumers — nearest-account-ids (nearestaccountids.spec.ts)
NEAREST_ACCOUNT_IDS_ACCOUNT_ID=8787878787

# Consumers — activation (activation.spec.ts)
CONSUMER_ACTIVATION_CONSUMER_ID=5633025000

# Consumers — profile (consumerprofile.spec.ts)
CONSUMER_PROFILE_CONSUMER_ID=5633025000
CONSUMER_PROFILE_IVRS=N3472031547
# CONSUMER_PROFILE_METER_ROUTE=meter-12345

# Consumers — real-time-power (realtimepower.spec.ts)
# IVRS that resolves; live phase readings may be null when meter has no recent IP row.
CONSUMER_RTP_IVRS=N3472029226
CONSUMER_RTP_CONSUMER_ID=N3472029226
# CONSUMER_RTP_METER_ROUTE=meter-12345

# Consumers — power-quality (powerquality.spec.ts)
# IVRS that resolves; live metrics may be null when meter has no recent IP row.
CONSUMER_PQ_IVRS=N3471011444
CONSUMER_PQ_CONSUMER_ID=N3471011444
# CONSUMER_PQ_METER_ROUTE=meter-12345

# Consumers — communication-status (communicationstatus.spec.ts)
# IVRS that resolves; interval counts may be 0/96 when meter has no LS/IP that day.
CONSUMER_COMM_STATUS_IVRS=N3471011444
CONSUMER_COMM_STATUS_DATE=2026-06-22
# CONSUMER_COMM_STATUS_METER_ROUTE=meter-12345

# Consumers — live-load-profile (liveloadprofile.spec.ts)
# IVRS that resolves; live metrics may be null when meter has no recent IP row.
CONSUMER_LLP_IVRS=N3374018980
CONSUMER_LLP_CONSUMER_ID=N3374018980
# CONSUMER_LLP_METER_ROUTE=meter-12345

# Consumers — energy-consumption-graph (energyconsumptiongraph.spec.ts)
# IVRS that resolves; live points may be all-zero when archive has no readings.
CONSUMER_ECG_IVRS=N3374018980
CONSUMER_ECG_CONSUMER_ID=N3374018980
# CONSUMER_ECG_METER_ROUTE=meter-12345

# Energy flow — GET /indore/consumers/{ref}/energy-flow?period=
CONSUMER_EF_IVRS=N3374018980
CONSUMER_EF_CONSUMER_ID=N3374018980
# CONSUMER_EF_METER_ROUTE=meter-12345

# Billing history — GET /indore/consumers/{ref}/billing-history?billingLimit=
CONSUMER_BH_IVRS=N3374018980
CONSUMER_BH_CONSUMER_ID=N3374018980
# CONSUMER_BH_METER_ROUTE=meter-12345

# Event log cards — GET /indore/consumers/{ref}/event-log/cards
CONSUMER_ELC_IVRS=N3374018980
CONSUMER_ELC_CONSUMER_ID=N3374018980
# CONSUMER_ELC_METER_ROUTE=meter-12345

# Event log list — GET /indore/consumers/{ref}/event-log/list?eventPage=&eventPageSize=
CONSUMER_ELL_IVRS=N3374018980
CONSUMER_ELL_CONSUMER_ID=N3374018980
# CONSUMER_ELL_METER_ROUTE=meter-12345

# Assignable meters are auto-provisioned in spec beforeAll when not set.
VALIDATE_CONSUMER_METER_ASSIGNABLE_SERIAL=
VALIDATE_CONSUMER_METER_NOT_IN_SYSTEM_SERIAL=891901
VALIDATE_CONSUMER_METER_ASSIGNED_SERIAL=
VALIDATE_CONSUMER_METER_INACTIVE_SERIAL=

VALIDATE_ADD_METER_VALID_SERIAL=
VALIDATE_ADD_METER_EXISTS_SERIAL=

# Master Data — create-meter (POST /indore/master-data/add-meter)
# Success test auto-generates a unique serial; duplicate test reuses VALIDATE_ADD_METER_EXISTS_SERIAL.
# CREATE_METER_DEVICE_MANUFACTURER_TBL_REF_ID=1
# CREATE_METER_METER_MODEL_TBL_REF_ID=1
# CREATE_METER_RAPDRP_CODE=AUTO-RAP
# CREATE_METER_ASSET_ID=AUTO-ASSET

# Master Data — bulk-upload-meters (POST /indore/master-data/bulk-upload-meters)
# Manufacturer name must match an active master-data manufacturer (template column).
BULK_METER_MANUFACTURER_NAME=L&T
# BULK_METER_MODEL_NAME=

# Master Data — create-dtr (POST /indore/master-data/add-dtr)
# Zone / Sub Station / Feeder lookup IDs must form a valid hierarchy chain.
# Valid Zone → Sub Station → Feeder chain (query L_Network_Lookup + M_Network_Hierarchy)
CREATE_DTR_ORGANISATION_LOOKUP_ID=30
CREATE_DTR_SUBSTATION_NETWORK_LOOKUP_ID=3
CREATE_DTR_FEEDER_NETWORK_LOOKUP_ID=4
# Optional override only — specs provision assignable meters via add-meter + validate-dtr-meter
# CREATE_DTR_UNMAPPED_METER_SERIALS=93041027,85092394
# CREATE_DTR_METER_PHASE_TBL_REF_ID=1
# Existing DTR code for duplicate test (CREATE_DTR_EXISTS_CODE)
CREATE_DTR_EXISTS_CODE=RJ662

# Master Data — bulk-upload-dtr (POST /indore/master-data/bulk-upload-dtr)
BULK_DTR_ZONE_NAME=Hawabangla
BULK_DTR_SUBSTATION_NAME=PragatiNagar
BULK_DTR_FEEDER_NAME=PARMANU NAGAR(CHQ)
BULK_DTR_MAIN_SUB_METER=Main
BULK_DTR_METER_PHASE=1 PH
# Must match utils meter-phases API (e.g. "1 PH", not "Three")

# Master Data — bulk-upload-consumers (POST /indore/master-data/bulk-upload-consumers)
# Reuses BULK_DTR_* zone/substation/feeder; assignable meters auto-provisioned via
# add-meter + GET /indore/consumers/validate-meter (same as create-consumer.spec.ts).
# CI/local fallbacks when unset: src/modules/MASTER-DATA/utils/master-data-env.helper.ts
BULK_CONSUMER_DTR_NAME=RJ662
BULK_CONSUMER_CATEGORY_NAME=Commercial
BULK_CONSUMER_CONNECTION_STATUS_NAME=Connected
BULK_CONSUMER_CONNECTION_TYPE_NAME=Prepaid
BULK_CONSUMER_BILLING_CYCLE_NAME=Monthly
BULK_CONSUMER_TOD_NAME=NO TOD LT
CREATE_CONSUMER_ORGANISATION_LOOKUP_ID=30
# Optional overrides — auto-resolved in spec beforeAll from consumer master when unset:
# BULK_CONSUMER_NEAREST_ACCT_ID=
# BULK_CONSUMER_EXISTS_CID=
# CREATE_CONSUMER_NETWORK_LOOKUP_ID=   # optional; auto-resolved from network-hierarchy + BULK_CONSUMER_DTR_NAME

# Master Data — meter-master-data search term (optional; defaults to 000248045)
# METER_MASTER_SEARCH_Q=000248045

# Master Data — consumer-master-data search term (optional; defaults to N3471011444)
# CONSUMER_MASTER_SEARCH_Q=N3471011444

# Asset Management — optional anchor IDs for edge / pagination tests
# ASSET_DTR_LOOKUP_ID=2339
# ASSET_NETWORK_ROOT_LOOKUP_ID=
# ASSET_ORG_ROOT_LOOKUP_ID=
# Optional scoped roles for data-scope coverage (asset-management-scope.spec.ts)
# Explicit credentials take priority. When unset, the test discovers Viewer/Operator/Manager
# users from GET /users and tries SCOPED_ROLE_PASSWORD or PASSWORD.
# VIEWER_EMAIL=
# VIEWER_PASSWORD=
# OPERATOR_EMAIL=
# OPERATOR_PASSWORD=
# SCOPED_ROLE_PASSWORD=

# Playwright parallel workers (default 2). Use 1 if token refresh races appear.
PLAYWRIGHT_WORKERS=2

# API test console: set true to also print the banner header block before the checklist
# API_TEST_VERBOSE_SUMMARY=false

# Print full API request/response JSON to console (every test). Also prints automatically on validation failure.
# API_TEST_PRINT_RESPONSE=true
