# DASHBOARD (src/modules/DASHBOARD)
# Set true after confirming Db/dashboard-sql.ts (network/meter universe counts)
# DASHBOARD_DB_SQL_READY=true

# Playwright parallel workers (default 2). Use 1 if token refresh races appear.
PLAYWRIGHT_WORKERS=2

# Contract snapshots (Cases / ATR-zone columns): set true to rewrite git-tracked baselines
# UPDATE_CONTRACT_SNAPSHOTS=false

# Mutation-proof: excluded from global `playwright test` unless true.
# revenue-protection + utils-lookup module runs always include them.
# INCLUDE_MUTATION_PROOF=false

# API test console: set true to also print the banner header block before the checklist
# API_TEST_VERBOSE_SUMMARY=false

# Print full API request/response JSON to console (every test). Also prints automatically on validation failure.
# API_TEST_PRINT_RESPONSE=true

