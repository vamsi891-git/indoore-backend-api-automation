{
  "name": "indoore_backend_testing",
  "version": "1.0.0",
  "description": "API automation with [Playwright Test](https://playwright.dev/) and TypeScript. Tests call HTTP APIs using a shared authenticated fixture; login runs once in global setup and saves storage state under `playwright/.auth/` (gitignored).",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:module": "node scripts/run-module-tests.mjs",
    "test:modules:list": "node scripts/run-module-tests.mjs list",
    "test:detect-modules": "node scripts/detect-changed-modules.mjs --test",
    "ci:detect-modules": "node scripts/detect-changed-modules.mjs",
    "check:env-example": "node scripts/check-env-example.mjs",
    "check:modules-ci": "node scripts/sync-module-workflow.mjs --check",
    "sync:modules-ci": "node scripts/sync-module-workflow.mjs",
    "obs:query": "ts-node --compilerOptions \"{\\\"module\\\":\\\"commonjs\\\"}\" src/observability/query.ts",
    "test:smoke:energy-audit": "playwright test src/modules/ENERGY-AUDITS/tests --grep @smoke",
    "test:energy-audit": "node scripts/run-module-tests.mjs energy-audits",
    "test:hes": "playwright test src/modules/HES-COMMANDS/tests --workers=1",
    "test:hes:e2e": "playwright test src/modules/HES-COMMANDS/tests --grep @e2e --workers=1",
    "test:commands": "playwright test src/modules/HES-COMMANDS/tests --workers=1 --grep @commands",
    "test:auth": "node --max-old-space-size=4096 ./node_modules/@playwright/test/cli.js test --grep @auth",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "allure:generate": "node scripts/write-allure-environment.mjs && node scripts/patch-allure-module-labels.mjs && allure generate allure-results -o allure-report --clean",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure open allure-report",
    "report:allure": "npm run allure:generate && npm run allure:open",
    "report:defects": "explorer reports\\defects",
    "typecheck": "tsc --noEmit",
    "test:inventory": "node scripts/test-inventory.mjs",
    "test:master-data": "playwright test src/modules/MASTER-DATA/tests --grep-invert @db",
    "test:master-data:db": "playwright test src/modules/MASTER-DATA/tests --grep @db",
    "test:billing": "playwright test src/modules/BILLING/tests --grep-invert @db",
    "test:billing:db": "playwright test src/modules/BILLING/tests --grep @db",
    "test:asset-management": "playwright test src/modules/ASSET-MANAGEMENT/tests --grep-invert @db",
    "test:asset-management:db": "playwright test src/modules/ASSET-MANAGEMENT/tests --grep @db",
    "test:db": "playwright test --grep @db",
    "db:ping": "node scripts/db-ping.mjs",
    "db:list": "node scripts/list-databases.mjs",
    "manual:workbook": "node scripts/build-manual-testing-workbook.mjs",
    "manual:populate": "node scripts/populate-module-test-cases.mjs",
    "manual:add-dtr-pack": "node scripts/build-add-dtr-test-pack.mjs",
    "docs:swagger": "node scripts/open-swagger.mjs",
    "docs:swagger:open": "node scripts/open-swagger.mjs --open",
    "test:unit": "playwright test src/core/__tests__"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "allure-commandline": "^2.42.1",
    "allure-playwright": "^3.10.0",
    "eslint": "^10.3.0",
    "exceljs": "^4.4.0",
    "playwright-html-reporter": "^0.1.11",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "dotenv": "^17.4.2",
    "imapflow": "^1.4.0",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  }
}
